NODE_ENV=development
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=XYZ
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumen_radar

# Discord Developer Portal > OAuth2
# Redirect: http://localhost:3000/api/auth/callback/discord
# Leave these empty to run locally without Discord login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional. Tests use DATABASE_URL if empty and create an isolated schema.
TEST_DATABASE_URL=

# Docker Compose uses its own PostgreSQL database instead of DATABASE_URL above.
POSTGRES_USER=lumen_radar
POSTGRES_DB=lumen_radar
# Use a URL-safe password, for example: openssl rand -hex 32
POSTGRES_PASSWORD=XYZ
